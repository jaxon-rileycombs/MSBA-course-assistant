# Class service endpoints (dobolyi.com, ports 9001+).
# Copy to `.env` and fill in the REAL values from the team's connection details.
# `.env` is gitignored — never commit real keys. Keep dummy values here.
#
# Exact role <-> port mapping follows the team's connection details; adjust
# the variable names below to match whichever service fills each role.

# Chat LLM (non-vision) — OpenAI-compatible chat completions
CLASS_LLM_BASE_URL=http://dobolyi.com:9001
CLASS_LLM_API_KEY=your-dummy-key-here

# Vision-capable LLM (for diagrams/charts and question answering)
CLASS_VISION_LLM_BASE_URL=http://dobolyi.com:9005
CLASS_VISION_LLM_API_KEY=your-dummy-key-here

# Text embeddings
CLASS_TEXT_EMBED_BASE_URL=http://dobolyi.com:9002
CLASS_TEXT_EMBED_API_KEY=your-dummy-key-here

# Visual (image) embeddings
CLASS_VISUAL_EMBED_BASE_URL=http://dobolyi.com:9003
CLASS_VISUAL_EMBED_API_KEY=your-dummy-key-here

# Multimodal reranking
CLASS_RERANK_BASE_URL=http://dobolyi.com:9004
CLASS_RERANK_API_KEY=your-dummy-key-here

# Document parsing (if the team provides one)
CLASS_PARSE_BASE_URL=http://dobolyi.com:9004
CLASS_PARSE_API_KEY=your-dummy-key-here

# LLM model names, as listed by each service's /v1/models
CLASS_LLM_MODEL=dummy-model-name
CLASS_VISION_LLM_MODEL=dummy-model-name
