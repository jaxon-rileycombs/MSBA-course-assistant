# Class service endpoints (dobolyi.com) — real connection details live in the
# team's class-endpoints.txt (2026-09-30). Copy this file to `.env` and fill
# in the REAL API keys locally (the shared doc ships with keys redacted).
# `.env` is gitignored — never commit real keys; keep dummy values in examples.
#
# Port 9000 (Hermes) is reserved exclusively for agentic use — do NOT use it.

# Vision-capable LLM (Q&A, quiz generation) — Qwen3.6-35B-A3B-AWQ-4bit (vLLM)
CLASS_VISION_LLM_BASE_URL=http://dobolyi.com:9001/v1
CLASS_VISION_LLM_API_KEY=your-dummy-key-here
CLASS_VISION_LLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit

# Text embeddings — Nemotron-3-Embed-1B-BF16
CLASS_TEXT_EMBED_BASE_URL=http://dobolyi.com:9002
CLASS_TEXT_EMBED_API_KEY=your-dummy-key-here
CLASS_TEXT_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16

# Visual (image) embeddings — Qwen3-VL-Embedding-2B
CLASS_VISUAL_EMBED_BASE_URL=http://dobolyi.com:9003/v1
CLASS_VISUAL_EMBED_API_KEY=your-dummy-key-here
CLASS_VISUAL_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B

# Multimodal reranking — Qwen3-VL-Reranker-2B
CLASS_RERANK_BASE_URL=http://dobolyi.com:9004
CLASS_RERANK_API_KEY=your-dummy-key-here
CLASS_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B

# Document parsing (OCR/visual) — dots.mocr; consult its /docs for the
# request format (vLLM-served, so likely multimodal chat completion)
CLASS_PARSE_BASE_URL=http://dobolyi.com:9005/v1
CLASS_PARSE_API_KEY=your-dummy-key-here
CLASS_PARSE_MODEL=dots.mocr

# Optional full-slide rendering for direct PPTX uploads. Requires LibreOffice,
# or Microsoft PowerPoint on Windows. Falls back to embedded pictures if unavailable.
COURSE_ASSISTANT_RENDER_PPTX=1

# Optional storage isolation. Keep indexes built with different embedding
# models in different directories; Chroma dimensions cannot be mixed.
COURSE_ASSISTANT_VECTOR_DIR=vectorstore-online
COURSE_ASSISTANT_REGISTRY_PATH=data/registry-online.json
